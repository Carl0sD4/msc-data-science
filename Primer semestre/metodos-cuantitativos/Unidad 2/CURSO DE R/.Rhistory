eig <- eigen(A)
# Tomamos el valor propio positivo (el dominante)
idx1     <- which.max(Re(eig$values))
lambda1  <- eig$values[idx1]      # λ1
v1       <- eig$vectors[, idx1]   # vector propio asociado
lambda1
v1
v1_ratio <- v1[1] / v1[2]         # v1^1 / v1^2
v1_ratio
